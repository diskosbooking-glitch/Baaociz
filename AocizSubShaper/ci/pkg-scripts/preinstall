#!/bin/bash
# Supprime les anciennes versions (y compris l'ancien nom « Aociz SubShaper »)
CONSOLE_USER=$(stat -f%Su /dev/console)
USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')

for BASE in "/Library/Audio/Plug-Ins" "$USER_HOME/Library/Audio/Plug-Ins"; do
    [ -z "$BASE" ] && continue
    rm -rf "$BASE/Components/Aociz SubShaper.component" "$BASE/VST3/Aociz SubShaper.vst3"
    rm -rf "$BASE/Components/Subshaper.component"      "$BASE/VST3/Subshaper.vst3"
done
exit 0
